  </data>
  <data name="AverageDownColor_DisplayName" xml:space="preserve">
    <value>Нижний цвет</value>
  </data>
  <data name="AverageDownColor_Description" xml:space="preserve">
    <value>Пересечение нуля и наклон: цвет ниже нуля или при падении.</value>
  </data>
  <data name="AverageWidth_DisplayName" xml:space="preserve">
