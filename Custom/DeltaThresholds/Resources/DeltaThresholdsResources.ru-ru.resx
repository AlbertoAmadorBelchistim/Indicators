  </data>
  <data name="AlertDownLevel_DisplayName" xml:space="preserve">
    <value>Нижний уровень</value>
  </data>
  <data name="AlertDownLevel_Description" xml:space="preserve">
    <value>Уровень для нижних оповещений.</value>
  </data>
