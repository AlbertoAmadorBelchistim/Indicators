  </data>
  <data name="ShowHistogram_Description" xml:space="preserve">
    <value>Zeichnet das Delta jeder Kerze. Ausschalten, um nur die Schwellen zu zeigen, z. B. im Panel des Delta-Indikators.</value>
  </data>
  <data name="UpColor_DisplayName" xml:space="preserve">
    <value>Positive Farbe</value>
  </data>
  <data name="UpColor_Description" xml:space="preserve">
    <value>Farbe der Kerzen mit positivem Delta.</value>
  </data>
  <data name="DownColor_DisplayName" xml:space="preserve">
    <value>Negative Farbe</value>
  </data>
  <data name="DownColor_Description" xml:space="preserve">
    <value>Farbe der Kerzen mit negativem Delta.</value>
  </data>
  <data name="Source_DisplayName" xml:space="preserve">
    <value>Schwellenquelle</value>
  </data>
  <data name="Source_Description" xml:space="preserve">
    <value>Fest: die vier Niveaus unten. Dynamisch: aus den bisherigen Kerzen der Sitzung; niedrig = Mittelwert der Kerzenextreme, hoch = Mittelwert + Multiplikator x Standardabweichung.</value>
  </data>
  <data name="StdMultiplier_DisplayName" xml:space="preserve">
    <value>Multiplikator der Standardabweichung</value>
  </data>
  <data name="StdMultiplier_Description" xml:space="preserve">
    <value>Dynamische Quelle: hohes Niveau = Mittelwert + dieser Wert x Standardabweichung.</value>
  </data>
  <data name="MinSamples_DisplayName" xml:space="preserve">
    <value>Mindestkerzen</value>
  </data>
  <data name="MinSamples_Description" xml:space="preserve">
    <value>Dynamische Quelle: geschlossene Kerzen der Sitzung, die nötig sind, bevor die Niveaus gezeichnet und verwendet werden.</value>
  </data>
  <data name="Window_DisplayName" xml:space="preserve">
    <value>Statistikfenster</value>
  </data>
  <data name="Window_Description" xml:space="preserve">
    <value>Dynamische Quelle: für die Statistik verwendete Kerzen. Ganze Sitzung: alle, Neustart bei jeder Standardsitzung. Zeitfenster: nur Kerzen, die zwischen Start- und Endzeit eröffnen; die Statistik beginnt mit jedem Fensterstart neu, außerhalb gibt es keine Niveaus.</value>
  </data>
  <data name="WindowStart_DisplayName" xml:space="preserve">
    <value>Fensterbeginn</value>
  </data>
  <data name="WindowStart_Description" xml:space="preserve">
    <value>Beginn des Zeitfensters in Chartzeit (inklusive). Ein Beginn nach dem Ende überschreitet Mitternacht.</value>
  </data>
  <data name="WindowEnd_DisplayName" xml:space="preserve">
    <value>Fensterende</value>
  </data>
  <data name="WindowEnd_Description" xml:space="preserve">
    <value>Ende des Zeitfensters in Chartzeit (exklusive).</value>
  </data>
  <data name="ShowThresholdLines_DisplayName" xml:space="preserve">
    <value>Schwellenlinien anzeigen</value>
  </data>
