  <data name="ShowHistogram_DisplayName" xml:space="preserve">
    <value>Show histogram</value>
  </data>
  <data name="ShowHistogram_Description" xml:space="preserve">
    <value>Draws the delta of each bar. Turn it off to show only the thresholds, for example over the Delta indicator's panel.</value>
  </data>
  <data name="UpColor_DisplayName" xml:space="preserve">
    <value>Positive color</value>
  </data>
  <data name="UpColor_Description" xml:space="preserve">
    <value>Color of the bars with a positive delta.</value>
  </data>
  <data name="DownColor_DisplayName" xml:space="preserve">
    <value>Negative color</value>
  </data>
  <data name="DownColor_Description" xml:space="preserve">
    <value>Color of the bars with a negative delta.</value>
  </data>
  <data name="Source_DisplayName" xml:space="preserve">
    <value>Threshold source</value>
  </data>
  <data name="Source_Description" xml:space="preserve">
    <value>Fixed: the four levels below. Dynamic: from the bars of the session so far; minor = mean of the bar extremes, major = mean + multiplier x standard deviation.</value>
  </data>
  <data name="StdMultiplier_DisplayName" xml:space="preserve">
    <value>Standard deviation multiplier</value>
  </data>
  <data name="StdMultiplier_Description" xml:space="preserve">
    <value>Dynamic source: major level = mean + this x standard deviation.</value>
  </data>
  <data name="MinSamples_DisplayName" xml:space="preserve">
    <value>Minimum bars</value>
  </data>
  <data name="MinSamples_Description" xml:space="preserve">
    <value>Dynamic source: closed bars of the session needed before the levels are drawn and used.</value>
  </data>
  <data name="Window_DisplayName" xml:space="preserve">
    <value>Statistics window</value>
  </data>
  <data name="Window_Description" xml:space="preserve">
    <value>Dynamic source: bars used for the statistics. Full session: every bar, restarting at each default session. Time window: only bars that open between the start and end times; the statistics restart at each window start and there are no levels outside the window.</value>
  </data>
  <data name="WindowStart_DisplayName" xml:space="preserve">
    <value>Window start</value>
  </data>
  <data name="WindowStart_Description" xml:space="preserve">
    <value>Time window start, in chart time (included). A start later than the end crosses midnight.</value>
  </data>
  <data name="WindowEnd_DisplayName" xml:space="preserve">
    <value>Window end</value>
  </data>
  <data name="WindowEnd_Description" xml:space="preserve">
