    <value>Only at bar close</value>
  </data>
  <data name="AlertAtBarClose_Description" xml:space="preserve">
    <value>On: alerts when a bar closes with its delta beyond the level. Off: alerts as soon as the delta of the forming bar reaches the level.</value>
  </data>
  <data name="AlertCooldownBars_DisplayName" xml:space="preserve">
    <value>Minimum bars between alerts</value>
  </data>
  <data name="AlertCooldownBars_Description" xml:space="preserve">
