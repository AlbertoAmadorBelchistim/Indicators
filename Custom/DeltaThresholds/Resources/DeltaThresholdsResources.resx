  </data>
  <data name="AlertUpLevel_DisplayName" xml:space="preserve">
    <value>Up level</value>
  </data>
  <data name="AlertUpLevel_Description" xml:space="preserve">
    <value>Level used for the up alerts.</value>
  </data>
  <data name="AlertDownLevel_DisplayName" xml:space="preserve">
    <value>Down level</value>
  </data>
  <data name="AlertDownLevel_Description" xml:space="preserve">
    <value>Level used for the down alerts.</value>
  </data>
