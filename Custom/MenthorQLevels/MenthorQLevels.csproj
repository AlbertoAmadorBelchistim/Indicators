<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\AtasFlavors.props" />

	<PropertyGroup>
		<!-- Same assembly name in every flavor, so saved templates resolve the type after switching flavors. -->
		<AssemblyName>MenthorQLevels</AssemblyName>
		<Version>0.9.0</Version>
	</PropertyGroup>

	<!-- Localized UI strings. The public MenthorQLevelsResources class is generated at build time
	     from the neutral file (no checked-in Designer.cs); each culture file becomes a satellite
	     assembly that the deploy step copies to the root of the Indicators folder. -->
	<ItemGroup>
		<EmbeddedResource Update="Resources\MenthorQLevelsResources.resx">
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>ATAS.Indicators.Technical</StronglyTypedNamespace>
			<StronglyTypedClassName>MenthorQLevelsResources</StronglyTypedClassName>
			<StronglyTypedFileName>$(IntermediateOutputPath)MenthorQLevelsResources.Designer.cs</StronglyTypedFileName>
			<StronglyTypedManifestPrefix>ATAS.Indicators.Technical.Resources</StronglyTypedManifestPrefix>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\MenthorQLevelsResources.*.resx">
			<DependentUpon>MenthorQLevelsResources.resx</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>
</Project>
